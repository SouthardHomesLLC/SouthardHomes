        floorplanName="The Monarch"
        fpBeds="3"
        fpBath="3.5"
        fpGarage="2-car"
        fpSqFt="2,050"
        floorplanLink="https://i.postimg.cc/s2HTmjvq/ae17ae5883ec67bfa0896e6caf0d4877l-m2430276894rd-w2048-h1536.webp"
        dfloorplanLink="https://i.postimg.cc/X76yTR5P/The-Monarch.jpg"
      />
      <FloorplanCard
