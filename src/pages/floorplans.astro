        dfloorplanLink=""
      />

      <FloorplanCard
        floorplanImg="https://i.postimg.cc/R0W6mz0g/The-Shotgun-front.jpg"
        fpAlt="The Shotgun Floorplan"
        floorplanName="The Shotgun"
        fpBeds="3"
        fpBath="2"
        fpGarage="No"
        fpSqFt="1,152"
        floorplanLink="https://i.postimg.cc/pT8m9Yzd/The-Shotgun-2D.png"
        dfloorplanLink=""
      />
    </div>
    <Cta />
  </Container>
</Layout>

<script>
  import PhotoSwipeLightbox from "photoswipe/lightbox";
  import "photoswipe/style.css";

  const lightbox = new PhotoSwipeLightbox({
    gallery: "#floorplan-gallery",
    children: "a.pswp-link", //Explicitly targets ONLY the 2D/3D links, not the whole card image
    pswpModule: () => import("photoswipe"),
  });

  lightbox.init();
</script>
